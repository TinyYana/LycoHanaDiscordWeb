---
const goodFits = [
  '喜歡動畫、漫畫、遊戲、音樂、音遊或二次元文化',
  '想找個沒有社交壓力、能自在待著的地方',
  '偶爾想推坑作品、分享圖、聊生活',
  '喜歡小型社群勝過大型公頻洗版',
  '不介意一陣一陣的節奏，有時靜、有時突然聊開',
];

const gentleBoundaries = [
  '只想進來廣告、自宣、拉人',
  '期待每天都有大量新訊息',
  '只想找任務制、排行榜型社群',
  '不尊重他人喜好與交流邊界',
];
---

<section class="section-shell">
  <div class="max-w-3xl">
    <h2 class="section-title">先看一下這裡是不是你想待的地方</h2>
    <p class="section-copy">
      我不太想把入口頁寫成招募公告。小社群最怕預期不一樣，所以先講清楚一點。
    </p>
  </div>
  <div class="mt-10 grid gap-10 md:grid-cols-2">
    <section class="border-t border-[var(--color-border-strong)] pt-5">
      <h3 class="text-xl font-bold text-[var(--color-text)]">會喜歡這裡的人，通常</h3>
      <ul class="mt-5 space-y-3">
        {
          goodFits.map((item) => (
            <li class="flex gap-3 text-[var(--color-text-muted)]">
              <span class="mt-3 h-px w-5 shrink-0 bg-[var(--color-accent)]" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>
    <section class="border-t border-[var(--color-border)] pt-5">
      <h3 class="text-xl font-bold text-[var(--color-text)]">
        可能不太適合的，是
      </h3>
      <ul class="mt-5 space-y-3">
        {
          gentleBoundaries.map((item) => (
            <li class="flex gap-3 text-[var(--color-text-muted)]">
              <span class="mt-3 h-px w-5 shrink-0 bg-[var(--color-border-strong)]" />
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-sm leading-7 text-[var(--color-text-muted)]">
        這不是在趕人。人就這麼少，大家待著舒服一點比較重要。
      </p>
    </section>
  </div>
</section>
