---
import { siteConfig } from '../../config/site';
---

<footer class="site-content border-t border-[var(--color-border)]">
  <div
    class="section-shell grid gap-8 py-10 md:grid-cols-[1fr_auto] md:items-center"
  >
    <div>
      <p class="text-xl font-bold text-[var(--color-text)]">
        {siteConfig.name}
      </p>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">
        建立於 {siteConfig.createdAt}
      </p>
      <p
        class="mt-2 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)]"
      >
        先看到這裡也可以。想加入就進來看看，裡面有人在。
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <a class="button-primary focus-ring" href={siteConfig.discordInviteUrl}
        >加入 Discord</a
      >
      <a class="button-secondary focus-ring" href="#top">回到頁首</a>
    </div>
  </div>
</footer>
