---
import { siteConfig } from '../../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner content-width">
    <h1 id="hero-title"><span>彼岸花</span>社群</h1>
    <div class="hero-copy">
      <p>
        聊動畫、漫畫、遊戲與音樂的<span class="keep-together"
          >繁中 Discord 小社群</span
        >。<br class="wide-break" />也聊日常，偶爾冒泡、想到再回來都可以。
      </p>
      <div class="hero-actions">
        <a class="primary-link" href={siteConfig.discordInviteUrl}
          >加入 Discord <span aria-hidden="true">↗</span></a
        >
        <a class="quiet-link" href="#life"
          >看看社群日常 <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
    <img
      class="hero-flower"
      src="/images/lycoris.svg"
      width="300"
      height="300"
      alt=""
      aria-hidden="true"
    />
  </div>
</section>
