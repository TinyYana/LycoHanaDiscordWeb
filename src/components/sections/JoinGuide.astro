---
const reminders = [
  '先看看各個頻道在聊什麼，找到對味的就可以加進去。',
  '想先潛一陣子沒問題，但有想聊的別憋著，丟出來就對了。',
  '聊天、推坑、分享圖都歡迎；洗頻、攻擊、硬打廣告就先不要。',
  '不確定什麼的時候，看一下頻道說明，或直接問都可以。',
];
---

<section class="section-shell">
  <div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-start">
    <div>
      <h2 class="section-title">進來之後，從哪開始都行</h2>
      <p class="section-copy">
        進來先逛逛，找到對味的頻道就可以丟訊息了。想先潛一陣子也行，但有想聊的別客氣。
      </p>
    </div>
    <ol class="border-t border-[var(--color-border)]">
      {
        reminders.map((item, index) => (
          <li class="grid gap-4 border-b border-[var(--color-border)] py-4 text-[var(--color-text-muted)] sm:grid-cols-[3rem_1fr]">
            <span class="text-sm font-black text-[var(--color-accent)]">
              0{index + 1}
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
