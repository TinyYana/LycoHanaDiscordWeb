---
import ThemeToggle from '../components/interactive/ThemeToggle';
import { siteConfig } from '../config/site';
import { faqItems } from '../data/faq';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? siteConfig.name;
const description = Astro.props.description ?? siteConfig.description;
const canonical = siteConfig.canonicalUrl;
const socialImageUrl = new URL(siteConfig.socialImage, canonical).toString();
const socialImageWidth = siteConfig.socialImageWidth.toString();
const socialImageHeight = siteConfig.socialImageHeight.toString();
const organizationId = `${canonical}#organization`;
const websiteId = `${canonical}#website`;
const webpageId = `${canonical}#webpage`;
const faqId = `${canonical}#join`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteConfig.name,
      alternateName: siteConfig.englishName,
      url: canonical,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.png', canonical).toString(),
        width: 128,
        height: 128,
      },
      foundingDate: siteConfig.createdAtISO,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: canonical,
      name: siteConfig.name,
      alternateName: siteConfig.englishName,
      description,
      inLanguage: siteConfig.language,
      publisher: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical,
      name: title,
      description,
      inLanguage: siteConfig.language,
      isPartOf: {
        '@id': websiteId,
      },
      about: {
        '@id': organizationId,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: socialImageUrl,
        width: siteConfig.socialImageWidth,
        height: siteConfig.socialImageHeight,
      },
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content={siteConfig.keywords.join(', ')} />
    <meta name="robots" content="index, follow" />
    <meta name="application-name" content={siteConfig.name} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={siteConfig.backgroundColor}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#161618"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:type" content={siteConfig.socialImageType} />
    <meta property="og:image:alt" content={siteConfig.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.socialImageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      (() => {
        const storageKey = 'lycohana-theme';
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem(storageKey);
        } catch {
          // Fall back to the system theme if storage is unavailable.
        }
        const preferred = window.matchMedia('(prefers-color-scheme: dark)')
          .matches
          ? 'dark'
          : 'light';
        const theme =
          stored === 'light' || stored === 'dark' ? stored : preferred;
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="header-inner content-width">
        <a class="brand" href="#top" aria-label="彼岸花社群，回到頁首">
          <span>{siteConfig.name}</span>
        </a>
        <nav class="main-nav" aria-label="主要導覽">
          <a href="#life" aria-label="社群日常">日常</a>
          <a href="#archive" aria-label="社群紀錄">紀錄</a>
          <a href="#join" aria-label="加入前須知">加入</a>
        </nav>
        <div class="header-actions">
          <ThemeToggle client:load />
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
