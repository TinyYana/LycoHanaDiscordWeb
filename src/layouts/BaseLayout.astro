---
import ThemeToggle from '../components/interactive/ThemeToggle';
import { siteConfig } from '../config/site';
import { faqItems } from '../data/faq';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? siteConfig.name;
const description = Astro.props.description ?? siteConfig.description;
const canonical = siteConfig.canonicalUrl;
const socialImageUrl = new URL(siteConfig.socialImage, canonical).toString();
const socialImageWidth = siteConfig.socialImageWidth.toString();
const socialImageHeight = siteConfig.socialImageHeight.toString();
const organizationId = `${canonical}#organization`;
const websiteId = `${canonical}#website`;
const webpageId = `${canonical}#webpage`;
const faqId = `${canonical}#faq`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteConfig.name,
      alternateName: siteConfig.shortName,
      url: canonical,
      logo: {
        '@type': 'ImageObject',
        url: socialImageUrl,
        width: siteConfig.socialImageWidth,
        height: siteConfig.socialImageHeight,
      },
      foundingDate: siteConfig.createdAtISO,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: canonical,
      name: siteConfig.name,
      alternateName: siteConfig.shortName,
      description,
      inLanguage: siteConfig.language,
      publisher: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical,
      name: title,
      description,
      inLanguage: siteConfig.language,
      isPartOf: {
        '@id': websiteId,
      },
      about: {
        '@id': organizationId,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: socialImageUrl,
        width: siteConfig.socialImageWidth,
        height: siteConfig.socialImageHeight,
      },
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content={siteConfig.keywords.join(', ')} />
    <meta name="robots" content="index, follow" />
    <meta name="application-name" content={siteConfig.name} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={siteConfig.backgroundColor}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#151019"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:type" content={siteConfig.socialImageType} />
    <meta property="og:image:alt" content={siteConfig.socialImageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.socialImageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      (() => {
        const storageKey = 'lycohana-theme';
        const root = document.documentElement;
        const stored = localStorage.getItem(storageKey);
        const preferred = window.matchMedia('(prefers-color-scheme: dark)')
          .matches
          ? 'dark'
          : 'light';
        const theme =
          stored === 'light' || stored === 'dark' ? stored : preferred;
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header
        class="site-content sticky top-0 z-30 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg-soft)_82%,transparent)] backdrop-blur-xl"
      >
        <nav
          class="mx-auto flex w-[min(100%-24px,1120px)] items-center justify-between gap-4 py-3"
          aria-label="主要導覽"
        >
          <a
            class="focus-ring flex min-w-0 items-center gap-3 rounded-full"
            href="#top"
            aria-label="回到 LycoHana 彼岸花社群頁首"
          >
            <img
              class="size-9 shrink-0 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-accent-soft)] object-cover"
              src="/favicon.png"
              width="36"
              height="36"
              alt=""
              aria-hidden="true"
            />
            <span
              class="hidden text-sm font-bold text-[var(--color-text)] sm:inline"
            >
              LycoHana
            </span>
          </a>
          <div class="flex items-center gap-2">
            <a
              class="focus-ring hidden rounded-full px-3 py-2 text-sm font-medium text-[var(--color-text-muted)] transition hover:text-[var(--color-text)] md:inline-flex"
              href="#rhythm"
            >
              社群節奏
            </a>
            <a
              class="focus-ring hidden rounded-full px-3 py-2 text-sm font-medium text-[var(--color-text-muted)] transition hover:text-[var(--color-text)] md:inline-flex"
              href="#picks"
            >
              精選推坑
            </a>
            <a
              class="button-primary focus-ring max-sm:!hidden sm:inline-flex"
              href={siteConfig.discordInviteUrl}
            >
              加入 Discord
            </a>
            <ThemeToggle client:load />
          </div>
        </nav>
      </header>
      <main id="top" class="site-content">
        <slot />
      </main>
    </div>
  </body>
</html>
